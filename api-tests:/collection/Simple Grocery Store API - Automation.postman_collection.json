		{
			"name": "Adding an item to cart",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response=pm.response.json()",
							"",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Basic test', function () {",
							"    pm.expect(response).to.be.a('Object')",
							"    pm.expect(response.created).to.be.true",
							"    pm.expect(response.itemId).to.be.a('Number')",
							"})",
							"",
							"pm.test(\"Item added successfully\", function () {",
							"    pm.expect(response).to.have.property(\"created\", true);",
							"    pm.expect(response).to.have.property(\"itemId\");",
							"})",
							"",
							"pm.environment.set('itemId',response.itemId)"
