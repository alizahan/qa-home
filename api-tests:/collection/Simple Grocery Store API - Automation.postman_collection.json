		{
			"name": "2 . Get Products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const products = pm.response.json();",
							"",
							"pm.test(\"Products list is not empty\", function () {",
							"    pm.expect(products.length).to.be.greaterThan(0);",
							"});",
							"",
							"pm.test(\"Each product has id and name property\", function () {",
							"    pm.expect(products[19]).to.have.property(\"id\"); // 19'th product have this property",
							"    pm.expect(products[0]).to.have.property(\"name\");",
							"});",
							"",
							"//Saving the first product ID dynamically as a variable.",
							"pm.environment.set(\"productId\", products[3].id);",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
